---
import Icon from './Icon.astro';
---
<div class="theme-picker">
  <button class="theme-toggle" type="button" data-theme-toggle disabled
    aria-label="切換主題，目前：跟隨系統；下一個：淺色"
    title="切換主題，目前：跟隨系統；下一個：淺色">
    <span data-theme-icon="system"><Icon name="monitor" size={20} /></span>
    <span data-theme-icon="light"><Icon name="sun" size={20} /></span>
    <span data-theme-icon="dark"><Icon name="moon" size={20} /></span>
  </button>
</div>
<script>
  import { initializeThemeToggle } from '../scripts/theme';
  initializeThemeToggle();
</script>
