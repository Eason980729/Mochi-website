---
import { site } from '../data/site';
---
<a class="brand" href="/" aria-label={`${site.name} 官方首頁，${site.nameNote}`}>
  <span class="brand-mark" aria-hidden="true">
    <img src={site.logo} width="25" height="25" alt="" />
  </span>
  <span class="brand-name">{site.name}</span><span class="brand-note">{site.nameNote}</span>
</a>
