---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

{site.inviteUrl ? (
  <a class="button button-primary" href={site.inviteUrl} rel="noopener noreferrer">
    邀請機器人 <Icon name="external" size={18} />
  </a>
) : (
  <>
    <button class="button button-primary" type="button" data-invite-trigger aria-haspopup="dialog" aria-controls="invite-dialog">
      邀請機器人 <Icon name="external" size={18} />
    </button>
    <dialog id="invite-dialog" class="invite-dialog" aria-labelledby="invite-dialog-title" aria-describedby="invite-dialog-description">
      <button class="dialog-close" type="button" data-close-invite aria-label="關閉提示視窗">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <h2 id="invite-dialog-title">功能開發中</h2>
      <p id="invite-dialog-description">機器人目前仍在開發與準備階段，暫時尚未開放公開邀請，敬請期待！</p>
      <div class="dialog-actions"><button class="button button-primary" type="button" data-close-invite autofocus>我知道了</button></div>
    </dialog>
  </>
)}

<script>
  import { initializeInviteDialog } from '../scripts/invite-dialog';
  initializeInviteDialog();
</script>

<style>
  .invite-dialog {
    position: fixed;
    inset: 0;
    width: min(28rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--site-border);
    border-radius: 7px;
    background: var(--site-surface);
    color: var(--site-text);
  }
  .invite-dialog::backdrop { background: rgb(0 0 0 / 48%); }
  .dialog-close {
    position: absolute;
    top: .5rem;
    right: .5rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 4px;
    color: var(--site-muted);
  }
  .dialog-close:hover { background: var(--site-subtle); color: var(--site-text); }
  h2 { padding-right: 2rem; font-size: 1.25rem; }
  p { margin-top: 1rem; color: var(--site-muted); }
  .dialog-actions { display: flex; justify-content: flex-end; margin-top: 1.5rem; }
</style>
