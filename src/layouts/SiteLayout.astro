---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { themeBootstrap } from '../scripts/theme-bootstrap';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, ''), Astro.site);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{home ? `${site.name}｜社群日常工具` : `${title}｜${site.name}`}</title>
    <link rel="canonical" href={canonical} /><link rel="icon" href={site.logo} type="image/png" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="zh_TW" /><meta property="og:url" content={canonical} />
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a><SiteHeader />
    <main id="main-content" tabindex="-1" class:list={{ 'inner-page': !home }}>
      {!home && <div class="container page-heading"><p class="eyebrow">DISCORD BOT / INFORMATION</p><h1>{title}</h1></div>}
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
